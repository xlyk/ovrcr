[
  {
    "label": "macos-tests",
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--all-targets",
      "--all-features"
    ],
    "exit_code": 0
  },
  {
    "label": "macos-clippy",
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--all-features",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "label": "format",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "label": "doctests",
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--doc"
    ],
    "exit_code": 0
  }
]
