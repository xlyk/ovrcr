cycle|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Ainitial_prompt|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aoperator_e2e|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aoperator_scope|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Api_delegation|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Api_package|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aprovider_quota|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aquota_ui_option_a_smoke|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aregistry_migration|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aresource_cli|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aretained_capacity|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aretained_ownership|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aretained_sessions|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aserver_lifecycle|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Atask_execution|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aterminal_acceptance|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Atui|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Awip_save|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aworkspace_identity|live%3A%3Acommand_clears_inherited_reporting_authority|default""]","0.106s first attempt, one hosted attempt (single spawn, no server); the same body is compiled into each of the 28 binaries that #[path]-include tests/support/live.rs, so the run executes 28 copies of these three assertions",0.106,0.106,1,0,hosted-single-run,evidence/macos-job.log:1613 (PASS attempt 1); run 42429838269 job 128576086691,shared-fixtures-001,independent-shared-check-1
