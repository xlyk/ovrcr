cycle|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Ainitial_prompt|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aoperator_e2e|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aoperator_scope|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Api_delegation|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Api_package|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aprovider_quota|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aquota_ui_option_a_smoke|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aresource_cli|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aretained_capacity|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aretained_ownership|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aretained_sessions|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aserver_lifecycle|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Asettings_lifecycle|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Atask_execution|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aterminal_acceptance|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Atui|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Awip_save|live%3A%3Acommand_clears_inherited_reporting_authority|default"", ""nextest|Test|ovrcr%3A%3Aworkspace_identity|live%3A%3Acommand_clears_inherited_reporting_authority|defau