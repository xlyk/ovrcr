+fn probe_diag(message: &str) {
+    eprintln!("version probe diagnostic: {message}");
+    if let Ok(probe) = std::env::var("OVRCR_TEST_PROBE") {
+        use std::io::Write;
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(format!("{probe}.probe-diag"))
+        {
+            let _ = writeln!(file, "{message}");
+        }
+    }
+}
