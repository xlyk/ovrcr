+pub fn probe_diag(message: &str) {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0);
+    let message = format!("{now} pid={} {message}", std::process::id());
+    eprintln!("version probe diagnostic: {message}");
+    if let Ok(probe) = std::env::var("OVRCR_TEST_PROBE") {
+        use std::io::Write;
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(format!("{probe}.probe-diag"))
+        {
+            let _ = writeln!(file, "{message}");
+        }
+    }
+}
